@{
    ViewBag.Title = "Rauthom";
    Layout = null;
    //Layout = "~/Views/Shared/_LayoutMaster1.cshtml";
}

<style>
    .fm-menu a {
        background-color: aqua;
        padding: 10px;
        text-decoration: none;
        color: brown;
        position: relative;
    }
        /* a:visited{
        color:red;

    }*/
        .fm-menu a.active {
            background-color: greenyellow;
        }

        .fm-menu a:visited {
            background-color: green;
        }

        .fm-menu a:hover {
            background-color: yellow;
        }

            .fm-menu a:hover::after {
                position: absolute;
                left: 10px;
                right: 10px;
                height: 2px;
                background: red;
                content: "";
                bottom: 5px;
            }

    tr:first-child {
        background-color: yellow;
    }

    tr:nth-child(2n+1):not(:first-child):not(:last-child) {
        background-color: lightpink;
    }

    /*tr:nth-child(2n):not(:first-child):not(:last-child) {
        background-color: purple;
    }*/

    tr:hover {
        background-color: coral;
    }

    tr:last-child {
        background-color: green;
    }

    input:focus {
        background-color: aqua;
    }

    input[type="checkbox"]:checked + label {
        font-weight: bold;
        color: blue;
    }

    input:required {
        border-left: 3px solid red;
    }

    input {
        height: 30px;
        border-radius: 5px;
    }

        input:valid {
            color: green;
        }

        input:invalid {
            color: red;
        }

    .box-size {
        width: 400px;
        height: 300px;
        background-color: aqua;
        margin: 10px;
    }

    .tab-mn {
        margin-top: 30px;
    }

    #div1 {
        background-color: palevioletred;
    }

    #div2 {
        background-color: red;
    }

    #div3 {
        background-color: lightpink;
    }
</style>
<nav class="fm-menu">
    <a href="#" class="active">Trang chủ</a>
    <a href="#">Sản phẩm</a>
    <a href="#">Tin tức</a>
</nav>
<div class="tab-mn">
    <a href="#div1">Link 1</a>
    <a href="#div1">Link 2</a>
    <a href="#div1">Link 3</a>
</div>
@*<h2>Form Register</h2>*@

<form action="#" style="margin-top:50px">
    <table style="width:50%">
        <tr>
            <td colspan="2">Form Register</td>
        </tr>
        <tr>
            <td>
