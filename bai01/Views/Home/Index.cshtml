        </tr>

        <tr>
            <td>
                <label for="age">Age : </label>
            </td>
            <td>
                <input type="number" name="age" max="60" min="1" />
            </td>
        </tr>

        <tr>
            <td>
                <label for="age">Age : </label>
            </td>
            <td>
                <input type="number" name="age" />
            </td>
        </tr>

        <tr>
            <td>
                <label for="age">Age : </label>
            </td>
            <td>
                <input type="number" name="age" />
            </td>
        </tr>

        <tr>
            <td>
                <label for="Favourite">Favourite : </label>
            </td>
            <td>
                <input type="checkbox" name="Favourite" />
                <label for="Favourite">Walking </label>

                <input type="checkbox" name="Favourite" />
                <label for="Favourite">Reading Books </label>

                <input type="checkbox" name="Favourite" />
                <label for="Favourite">Sleeping </label>

                <input type="checkbox" name="Favourite" />
                <label for="Favourite">Gaming </label>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <button type="submit">Submit</button>
            </td>
        </tr>
    </table>
</form>

<div id="div1" class="box-size"></div>
<div id="div2" class="box-size"></div>
<div id="div3" class="box-size"></div>